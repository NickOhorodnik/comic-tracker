{
  "manifest_version": 3,
  "name": "Comic Tracker Bridge",
  "version": "1.0.1",
  "description": "Imports comic metadata directly from active reader pages into Comic Tracker",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://com-x.life/*",
    "https://*.com-x.life/*",
    "https://batcave.biz/*",
    "https://*.batcave.biz/*",
    "https://comic-tracker.allonsy.agency/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.com-x.life/*",
        "https://*.batcave.biz/*",
        "https://comic-tracker.allonsy.agency/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
